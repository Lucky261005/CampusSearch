# Reference only: the backend reads ENVIRONMENT VARIABLES and does not load .env files.
# Set these in the PowerShell window that starts the backend, e.g.  $env:GROQ_API_KEY = "..."
# Never commit a real key. .env files are gitignored.

# Optional. Your own Groq key; without it, search works and Ask AI shows retrieved passages.
GROQ_API_KEY=
# Optional. Groq model id (default openai/gpt-oss-120b).
GROQ_MODEL=

# Local AI limits (non-secret; defaults shown).
CAMPUSSEARCH_AI_DAILY_LIMIT=10
CAMPUSSEARCH_AI_PER_MINUTE_LIMIT=3
CAMPUSSEARCH_AI_MAX_TOKENS=600

DATABASE_URL=postgresql://campus:campus@localhost:5432/campussearch
